import { Button, LineEdit, VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme — black bg, white fg, subtle borders.
// ---------------------------------------------------------------------------
export global Theme {
    out property <color> bg:           #000000;
    out property <color> surface0:     #000000;
    out property <color> surface1:     #000000;
    out property <color> surface2:     #000000;
    out property <color> accent:       #000000;
    out property <color> accent-hover: #ffffff;
    out property <color> border:       #3a3a3a;
    out property <color> fg:           #ffffff;
    out property <color> fg-dim:       #777777;
    out property <color> danger:       #ff4444;
    out property <length> pad: 8px;
    out property <length> gap: 6px;
    out property <length> rad: 5px;
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------
export struct TabData {
    id: int,
    title: string,
}

export struct PanelData {
    id: int,
    mode_index: int,
    keys: [string],
    key_count: int,
    key_indices: [int],
    key_desc: string,
    interval_sec: string,
    interval_min: string,
    duration: string,
    target_index: int,
    target_labels: [string],
    status: string,
    running: bool,
    scanning: bool,
}

// ---------------------------------------------------------------------------
// Reusable styled components
// ---------------------------------------------------------------------------

// Compact hover-aware button — black bg, subtle border, inverts on hover.
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    callback clicked();
    height: 26px;
    min-width: 72px;
    background: disabled ? Theme.surface1 : (ta.has-hover ? #ffffff : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    opacity: disabled ? 0.4 : 1.0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: label;
            color: disabled ? Theme.fg-dim : (ta.has-hover ? #000000 : #ffffff);
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { if (!disabled) { root.clicked(); } }
        mouse-cursor: pointer;
    }
}

// X close button — centered vector cross (white), red hover tint.
component CloseBtn inherits Rectangle {
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: ta.has-hover ? #33ff4444 : transparent;
    Path {
        x: 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        stroke: ta.has-hover ? #ff4444 : #ffffff;
        stroke-width: 2px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Fully-styled dropdown — pure black bg, 1px white border, white dividers
// between items. Replaces the std ComboBox everywhere so nothing is grey.
component KeyDropdown inherits Rectangle {
    in property <[string]> model: [];
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    callback picked(int);
    in property <int> popup-max-items: 8;
    property <int> item-height: 22;
    height: 24px;
    background: #000000;
    border-width: 1px;
    border-color: enabled ? Theme.border : #2c2c2c;
    border-radius: 3px;
    opacity: enabled ? 1.0 : 0.45;

    // header cell: current value + chevron (chevron pinned to right edge)
    Text {
        x: 8px;
        width: parent.width - 30px;
        text: root.model.length > 0 ? root.model[root.current-index] : "";
        color: enabled ? #ffffff : #777777;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
    }
    // Chevron — one continuous V, wrapped in a Rectangle so it can rotate 180.
    // Closed = points down; open = rotates smoothly to point up; reverses on close.
    chev := Rectangle {
        x: root.width - 17px;
        y: (root.height - 6px) / 2;
        width: 10px;
        height: 6px;
        Path {
            x: 0; y: 0;
            width: 10px;
            height: 6px;
            stroke: enabled ? #ffffff : #777777;
            stroke-width: 2px;
            commands: "M 0 0 L 5 6 L 10 0";
        }
        transform-rotation: popup.is-open ? 180deg : 0deg;
        animate transform-rotation { duration: 150ms; easing: ease-in-out; }
    }
    header-ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => {
            if root.enabled {
                if popup.is-open {
                    popup.close();
                } else {
                    popup.show();
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 2px;
        width: root.width;
        height: min(root.model.length, root.popup-max-items) * root.item-height * 1px + 2px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: #000000;
            border-width: 1px;
            border-color: Theme.border;
            width: parent.width;
            height: parent.height;
            ScrollView {
                x: 1px; y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                viewport-height: root.model.length * root.item-height * 1px;
                VerticalLayout {
                    alignment: start;
                    for value[idx] in root.model: Rectangle {
                        background: ta-item.has-hover ? #ffffff
                                    : (idx == root.current-index ? #222222 : #000000);
                        height: root.item-height * 1px;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 4px;
                            spacing: 4px;
                            alignment: start;
                            Text {
                                text: value;
                                color: ta-item.has-hover ? #000000 : #ffffff;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                height: 100%;
                            }
                        }
                        // divider between items (except last)
                        if idx < root.model.length - 1: Rectangle {
                            x: 1px; y: parent.height - 1px;
                            width: parent.width - 2px;
                            height: 1px;
                            background: #2c2c2c;
                        }
                        ta-item := TouchArea {
                            clicked => {
                                root.current-index = idx;
                                root.picked(idx);
                                popup.close();
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// Compact bordered section card — black bg + outline + white divider under header.
component Card inherits Rectangle {
    in property <string> header;
    background: #000000;
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 6px;
        spacing: 4px;
        Text {
            text: root.header;
            color: Theme.fg;
            font-size: 11px;
            font-weight: 500;
        }
        @children
    }
}

// Compact numeric text field — pure black bg, subtle outline.
component TimeInput inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    width: 56px;
    height: 24px;
    background: #000000;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 4px;
    clip: true;
    field := TextInput {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        edited => {
            root.text = self.text;
            root.edited(self.text);
        }
    }
}

// One key-slot selector: small caption above a short, narrow dropdown.
// One key-slot selector: tiny inline index label + custom dropdown.
component KeySlot inherits HorizontalLayout {
    in property <int> index;
    in property <PanelData> data;
    callback picked(int);
    spacing: 6px;
    horizontal-stretch: 0;
    Text {
        text: "\{index + 1}";
        color: Theme.fg-dim;
        font-size: 10px;
        vertical-alignment: center;
        width: 8px;
        height: 24px;
    }
    KeyDropdown {
        width: 96px;
        model: data.keys;
        current-index: data.key_indices[index];
        picked(k) => {
            root.picked(k);
        }
    }
}

// ---------------------------------------------------------------------------
// Panel (one tab's content)
// ---------------------------------------------------------------------------
component PanelView inherits Rectangle {
    in property <PanelData> data;
    callback on_mode(int, int);
    callback on_key_slot(int, int, int);
    callback on_key_count(int, int);
    callback on_interval_sec(int, string);
    callback on_interval_min(int, string);
    callback on_duration(int, string);
    callback on_target(int, int);
    callback on_refresh(int);
    callback on_start(int);
    callback on_stop(int);

    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 20px;

            // ---- Injection mode ----
            Card {
                header: "INJECTION MODE";
                horizontal-stretch: 0;
                KeyDropdown {
                    width: 320px;
                    model: ["Window (PostMessage / Console / SendInput)", "Screen (OS-level SendInput)"];
                    current-index: data.mode_index;
                    picked(i) => {
                        root.on_mode(data.id, i);
                    }
                }
            }

            // ---- Target window ----
            Card {
                header: "TARGET WINDOW";
                horizontal-stretch: 0;
                HorizontalLayout {
                    spacing: 10px;
                    KeyDropdown {
                        enabled: data.mode_index == 0;
                        width: 320px;
                        model: data.target_labels;
                        current-index: data.target_index;
                        picked(i) => {
                            root.on_target(data.id, i);
                        }
                    }
                    Btn {
                        label: data.scanning ? "..." : "Refresh";
                        disabled: data.scanning || data.mode_index != 0;
                        clicked => { root.on_refresh(data.id); }
                    }
                }
            }

            // ---- Key selection (multi-key) ----
            Card {
                header: "KEY";
                horizontal-stretch: 0;
                VerticalLayout {
                    spacing: 6px;
                    // One tight row: "Keys:" + count combo + description
                    // followed inline by the 1..5 slot dropdowns.
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        Text {
                            text: "Keys:";
                            color: #ffffff;
                            font-size: 11px;
                            vertical-alignment: center;
                            height: 24px;
                        }
                        KeyDropdown {
                            width: 52px;
                            model: ["1", "2", "3", "4", "5"];
                            current-index: data.key_count - 1;
                            picked(i) => {
                                root.on_key_count(data.id, i + 1);
                            }
                        }
                        // Slot dropdowns — aligned on the same row.
                        ks-1 := KeySlot {
                            index: 0; data: data;
                            picked(k) => { root.on_key_slot(data.id, 0, k); }
                        }
                        ks-2 := KeySlot {
                            visible: data.key_count >= 2;
                            index: 1; data: data;
                            picked(k) => { root.on_key_slot(data.id, 1, k); }
                        }
                        ks-3 := KeySlot {
                            visible: data.key_count >= 3;
                            index: 2; data: data;
                            picked(k) => { root.on_key_slot(data.id, 2, k); }
                        }
                        ks-4 := KeySlot {
                            visible: data.key_count >= 4;
                            index: 3; data: data;
                            picked(k) => { root.on_key_slot(data.id, 3, k); }
                        }
                        ks-5 := KeySlot {
                            visible: data.key_count >= 5;
                            index: 4; data: data;
                            picked(k) => { root.on_key_slot(data.id, 4, k); }
                        }
                    }
                }
            }

            // ---- Timing ----
            Card {
                header: "TIMING";
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Interval";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_sec;
                        edited(t) => { root.on_interval_sec(data.id, t); }
                    }
                    Text {
                        text: "s";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_min;
                        edited(t) => { root.on_interval_min(data.id, t); }
                    }
                    Text {
                        text: "m";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }
                    Text {
                        text: "Duration";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.duration;
                        edited(t) => { root.on_duration(data.id, t); }
                    }
                    Text {
                        text: "m (0 = forever)";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Start / Stop + Status ----
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    label: data.running ? "Stop" : "Start";
                    clicked => {
                        if (data.running) {
                            root.on_stop(data.id);
                        } else {
                            root.on_start(data.id);
                        }
                    }
                }
                Text {
                    text: data.status;
                    color: #ffffff;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Tab strip entry: title + centered X close button.
// ---------------------------------------------------------------------------
component TabBtn inherits Rectangle {
    in property <string> title;
    in property <bool> active: false;
    callback clicked();
    callback close_requested();
    height: 28px;
    background: active ? #000000 : (title-ta.has-hover ? #000000 : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 2px;
        alignment: center;
        Text {
            text: title;
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
        }
        title-ta := TouchArea { clicked => { root.clicked(); } }
        CloseBtn {
            width: 20px;
            height: 20px;
            vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.close_requested(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Main application window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    preferred-width: 700px;
    preferred-height: 400px;
    min-width: 600px;
    min-height: 340px;
    background: Theme.bg;
    title: "AutoClick-RS";

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <[TabData]> tabs: [];
    in-out property <[PanelData]> panels: [];
    in-out property <int> current_idx: 0;

    callback add_tab();
    callback close_all();
    callback select_tab(int);
    callback close_tab(int);
    callback refresh_targets(int);
    callback start_sender(int);
    callback stop_sender(int);
    callback mode_changed(int, int);
    callback key_slot_changed(int, int, int);
    callback key_count_changed(int, int);
    callback interval_sec_changed(int, string);
    callback interval_min_changed(int, string);
    callback duration_changed(int, string);
    callback target_changed(int, int);

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // ---- Top toolbar ----
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: "AutoClick-RS";
                color: #ffffff;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { width: 6px; }
            Btn { label: "+ New";      clicked => { root.add_tab(); } }
            Btn { label: "Close All";  clicked => { root.close_all(); } }
        }

        // ---- Tab strip ----
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for tab[i] in tabs: TabBtn {
                title: tab.title;
                active: i == root.current_idx;
                clicked => { root.select_tab(i); }
                close_requested => { root.close_tab(i); }
            }
        }

        // ---- Divider ----
        Rectangle { height: 1px; background: Theme.border; }

        // ---- Active panel ----
        if root.current_idx >= 0 && root.current_idx < root.panels.length:
            PanelView {
                data: root.panels[root.current_idx];
                on_mode(id, m)         => { root.mode_changed(id, m); }
                on_key_slot(id, s, k)  => { root.key_slot_changed(id, s, k); }
                on_key_count(id, c)    => { root.key_count_changed(id, c); }
                on_interval_sec(id, v) => { root.interval_sec_changed(id, v); }
                on_interval_min(id, v) => { root.interval_min_changed(id, v); }
                on_duration(id, v)     => { root.duration_changed(id, v); }
                on_target(id, idx)     => { root.target_changed(id, idx); }
                on_refresh(id)         => { root.refresh_targets(id); }
                on_start(id)           => { root.start_sender(id); }
                on_stop(id)            => { root.stop_sender(id); }
            }
    }
}
