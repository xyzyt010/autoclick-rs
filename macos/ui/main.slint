import { Button, ComboBox, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme — black bg, white fg, subtle borders.
// ---------------------------------------------------------------------------
export global Theme {
    out property <color> bg:           #000000;
    out property <color> surface0:     #000000;
    out property <color> surface1:     #000000;
    out property <color> surface2:     #000000;
    out property <color> accent:       #000000;
    out property <color> accent-hover: #ffffff;
    out property <color> border:       #555555;
    out property <color> fg:           #ffffff;
    out property <color> fg-dim:       #777777;
    out property <color> danger:       #ff4444;
    out property <length> pad: 8px;
    out property <length> gap: 6px;
    out property <length> rad: 5px;
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------
export struct TabData {
    id: int,
    title: string,
}

export struct PanelData {
    id: int,
    mode_index: int,
    keys: [string],
    key_count: int,
    key_indices: [int],
    key_desc: string,
    interval_sec: string,
    interval_min: string,
    duration: string,
    target_index: int,
    target_labels: [string],
    status: string,
    running: bool,
    scanning: bool,
}

// ---------------------------------------------------------------------------
// Reusable styled components
// ---------------------------------------------------------------------------

// Compact hover-aware button — black bg, subtle border, inverts on hover.
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    callback clicked();
    height: 26px;
    min-width: 72px;
    background: disabled ? Theme.surface1 : (ta.has-hover ? #ffffff : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    opacity: disabled ? 0.4 : 1.0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: label;
            color: disabled ? Theme.fg-dim : (ta.has-hover ? #000000 : #ffffff);
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { if (!disabled) { root.clicked(); } }
        mouse-cursor: pointer;
    }
}

// X close button — centered vector cross (white), red hover tint.
component CloseBtn inherits Rectangle {
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: ta.has-hover ? #33ff4444 : transparent;
    Path {
        x: 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        stroke: ta.has-hover ? #ff4444 : #ffffff;
        stroke-width: 2px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Compact bordered section card — black bg + subtle outline.
component Card inherits Rectangle {
    in property <string> header;
    background: #000000;
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.header;
            color: Theme.fg;
            font-size: 11px;
            font-weight: 600;
        }
        @children
    }
}

// Compact numeric text field — pure black bg, subtle outline.
component TimeInput inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    width: 64px;
    height: 26px;
    background: #000000;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 4px;
    clip: true;
    field := TextInput {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        edited => {
            root.text = self.text;
            root.edited(self.text);
        }
    }
}

// ---------------------------------------------------------------------------
// Panel (one tab's content)
// ---------------------------------------------------------------------------
component PanelView inherits Rectangle {
    in property <PanelData> data;
    callback on_mode(int, int);
    callback on_key_slot(int, int, int);
    callback on_key_count(int, int);
    callback on_interval_sec(int, string);
    callback on_interval_min(int, string);
    callback on_duration(int, string);
    callback on_target(int, int);
    callback on_refresh(int);
    callback on_start(int);
    callback on_stop(int);

    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 6px;

            // ---- Injection mode ----
            Card {
                header: "INJECTION MODE";
                ComboBox {
                    model: ["Window (CGEvent / Console)", "Screen (OS-level SendInput)"];
                    current-index: data.mode_index;
                    selected(value) => {
                        root.on_mode(data.id, self.current-index);
                    }
                }
            }

            // ---- Target window ----
            Card {
                header: "TARGET WINDOW";
                HorizontalLayout {
                    spacing: 6px;
                    ComboBox {
                        model: data.target_labels;
                        current-index: data.target_index;
                        selected(value) => {
                            root.on_target(data.id, self.current-index);
                        }
                    }
                    Btn {
                        label: data.scanning ? "..." : "Refresh";
                        disabled: data.scanning;
                        clicked => { root.on_refresh(data.id); }
                    }
                }
            }

            // ---- Key selection (multi-key) ----
            Card {
                header: "KEY";
                VerticalLayout {
                    spacing: 6px;
                    // Key count selector
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Keys:";
                            color: #ffffff;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: ["1", "2", "3", "4", "5"];
                            current-index: data.key_count - 1;
                            selected(value) => {
                                root.on_key_count(data.id, self.current-index + 1);
                            }
                        }
                        Text {
                            text: data.key_desc;
                            color: Theme.fg-dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                    // Key slot selectors (1-5)
                    for slot[i] in 5: HorizontalLayout {
                        visible: i < data.key_count;
                        spacing: 8px;
                        Text {
                            text: "Key \{i + 1}:";
                            color: #ffffff;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            model: data.keys;
                            current-index: i < data.key_indices.length ? data.key_indices[i] : 0;
                            selected(value) => {
                                root.on_key_slot(data.id, i, self.current-index);
                            }
                        }
                    }
                }
            }

            // ---- Timing ----
            Card {
                header: "TIMING";
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Interval";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_sec;
                        edited(t) => { root.on_interval_sec(data.id, t); }
                    }
                    Text {
                        text: "s";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_min;
                        edited(t) => { root.on_interval_min(data.id, t); }
                    }
                    Text {
                        text: "m";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }
                    Text {
                        text: "Duration";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.duration;
                        edited(t) => { root.on_duration(data.id, t); }
                    }
                    Text {
                        text: "m (0 = forever)";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Start / Stop + Status ----
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    label: data.running ? "Stop" : "Start";
                    clicked => {
                        if (data.running) {
                            root.on_stop(data.id);
                        } else {
                            root.on_start(data.id);
                        }
                    }
                }
                Text {
                    text: data.status;
                    color: #ffffff;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Tab strip entry: title + centered X close button.
// ---------------------------------------------------------------------------
component TabBtn inherits Rectangle {
    in property <string> title;
    in property <bool> active: false;
    callback clicked();
    callback close_requested();
    height: 28px;
    background: active ? #000000 : (title-ta.has-hover ? #000000 : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 2px;
        alignment: center;
        Text {
            text: title;
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
        }
        title-ta := TouchArea { clicked => { root.clicked(); } }
        CloseBtn {
            width: 20px;
            height: 20px;
            vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.close_requested(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Main application window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    preferred-width: 700px;
    preferred-height: 400px;
    min-width: 600px;
    min-height: 340px;
    background: Theme.bg;
    title: "AutoClick-RS";

    in-out property <[TabData]> tabs: [];
    in-out property <[PanelData]> panels: [];
    in-out property <int> current_idx: 0;
    in-out property <string> perm_warning: "";

    callback add_tab();
    callback close_all();
    callback select_tab(int);
    callback close_tab(int);
    callback refresh_targets(int);
    callback start_sender(int);
    callback stop_sender(int);
    callback mode_changed(int, int);
    callback key_slot_changed(int, int, int);
    callback key_count_changed(int, int);
    callback interval_sec_changed(int, string);
    callback interval_min_changed(int, string);
    callback duration_changed(int, string);
    callback target_changed(int, int);
    callback open_accessibility_settings();

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // ---- Top toolbar ----
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: "AutoClick-RS";
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { width: 6px; }
            Btn { label: "+ New";      clicked => { root.add_tab(); } }
            Btn { label: "Close All";  clicked => { root.close_all(); } }
        }

        // ---- Tab strip ----
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for tab[i] in tabs: TabBtn {
                title: tab.title;
                active: i == root.current_idx;
                clicked => { root.select_tab(i); }
                close_requested => { root.close_tab(i); }
            }
        }

        // ---- Divider ----
        Rectangle { height: 1px; background: Theme.border; }

        // ---- macOS Accessibility Warning ----
        if root.perm_warning != "":
            Rectangle {
                background: #000000;
                border-radius: Theme.rad;
                border-width: 1px;
                border-color: #ff4444;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: root.perm_warning;
                        color: #ff8888;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Btn {
                        label: "Open System Settings";
                        clicked => { root.open_accessibility_settings(); }
                    }
                }
            }

        // ---- Active panel ----
        if root.current_idx >= 0 && root.current_idx < root.panels.length:
            PanelView {
                data: root.panels[root.current_idx];
                on_mode(id, m)         => { root.mode_changed(id, m); }
                on_key_slot(id, s, k)  => { root.key_slot_changed(id, s, k); }
                on_key_count(id, c)    => { root.key_count_changed(id, c); }
                on_interval_sec(id, v) => { root.interval_sec_changed(id, v); }
                on_interval_min(id, v) => { root.interval_min_changed(id, v); }
                on_duration(id, v)     => { root.duration_changed(id, v); }
                on_target(id, idx)     => { root.target_changed(id, idx); }
                on_refresh(id)         => { root.refresh_targets(id); }
                on_start(id)           => { root.start_sender(id); }
                on_stop(id)            => { root.stop_sender(id); }
            }
    }
}
