import { Button, ComboBox, LineEdit, ListView, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme
// ---------------------------------------------------------------------------
export global Theme {
    out property <color> bg:        #000000;
    out property <color> surface0:  #0a0a0a;
    out property <color> surface1:  #111111;
    out property <color> surface2:  #1a1a1a;
    out property <color> accent:     #333333;
    out property <color> accent-hover:#444444;
    out property <color> border:     #2a2a2a;
    out property <color> fg:         #ffffff;
    out property <color> muted:      #888888;
    out property <color> muted2:     #555555;
    out property <color> danger:     #ff4444;
    out property <length> pad: 8px;
    out property <length> gap: 6px;
    out property <length> rad: 5px;
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------
export struct TabData {
    id: int,
    title: string,
}

export struct PanelData {
    id: int,
    key_index: int,
    mode_index: int,
    keys: [string],
    key_desc: string,
    interval_sec: string,
    interval_min: string,
    duration: string,
    target_index: int,
    target_labels: [string],
    terminal_count: int,
    search_text: string,
    status: string,
    running: bool,
    scanning: bool,
}

// ---------------------------------------------------------------------------
// Reusable styled components
// ---------------------------------------------------------------------------

// Compact hover-aware button.
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    callback clicked();
    height: 26px;
    min-width: 72px;
    background: disabled ? Theme.surface1 : (ta.has-hover ? Theme.accent-hover : Theme.accent);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    opacity: disabled ? 0.4 : 1.0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: label;
            color: disabled ? Theme.muted2 : Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { if (!disabled) { root.clicked(); } }
        mouse-cursor: pointer;
    }
}

// X close button — centered vector cross.
component CloseBtn inherits Rectangle {
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: ta.has-hover ? #33ff4444 : transparent;
    Path {
        x: 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        stroke: ta.has-hover ? #ff4444 : #ffffff;
        stroke-width: 2px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Compact bordered section card.
component Card inherits Rectangle {
    in property <string> header;
    background: Theme.surface0;
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.header;
            color: Theme.muted;
            font-size: 11px;
            font-weight: 600;
        }
        @children
    }
}

// ---------------------------------------------------------------------------
// Target dropdown — opens UPWARD to avoid screen cutoff, with section headers.
// ---------------------------------------------------------------------------
component TargetDropdown inherits Rectangle {
    in property <[string]> labels;
    in property <int> current-index;
    in property <int> terminal-count;
    in property <string> search-text;
    callback selected(int);
    callback filter(string);

    property <bool> open: false;
    property <int> gui-count: root.labels.length - root.terminal-count;
    height: 28px;
    min-width: 220px;

    ta := TouchArea {
        clicked => {
            root.open = !root.open;
            if (root.open) { popup.show(); } else { popup.close(); }
        }
        mouse-cursor: pointer;
    }

    // The dropdown trigger button
    Rectangle {
        border-radius: Theme.rad;
        border-width: 1px;
        border-color: root.open ? Theme.muted2 : Theme.border;
        background: Theme.surface1;
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            Text {
                text: root.current-index >= 0 && root.current-index < root.labels.length
                    ? root.labels[root.current-index]
                    : "Select window...";
                color: root.current-index >= 0 ? Theme.fg : Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.open ? "\u{25B2}" : "\u{25BC}";
                color: Theme.muted2;
                font-size: 9px;
                vertical-alignment: center;
                width: 12px;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        // Open upward — positioned above the trigger button
        y: -(255px + 2px);
        width: root.width;

        // Give the search field focus when the popup opens so the user can
        // type immediately (invisible search bar behavior).
        forward-focus: search-le;

        close-policy: close-on-click;

        Rectangle {
            background: Theme.surface0;
            border-radius: Theme.rad;
            border-width: 1px;
            border-color: Theme.border;
            height: 255px;
            vertical-stretch: 0;

            VerticalLayout {
                padding: 4px;
                spacing: 4px;

                // Search input — takes focus when the dropdown opens so the
                // user can type immediately (invisible search bar).
                search-le := LineEdit {
                    placeholder-text: "Type to search windows...";
                    text: root.search-text;
                    font-size: 11px;
                    height: 24px;
                    edited(t) => { root.filter(t); }
                    accepted => {
                        if (root.labels.length > 0) {
                            root.selected(0);
                            root.open = false;
                            popup.close();
                        }
                    }
                }

                // Empty state
                if root.labels.length == 0: Rectangle {
                    height: 60px;
                    Text {
                        text: "No matching windows";
                        color: Theme.muted;
                        font-size: 11px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Results with section headers — use ScrollView (ListView only allows one for)
                if root.labels.length > 0: sv := ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: 2px;
                        spacing: 0px;

                        // --- Terminals section header ---
                        if root.terminal-count > 0: Rectangle {
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "Terminals";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Terminal items
                        for idx in root.terminal-count: Rectangle {
                            height: 22px;
                            border-radius: 3px;
                            background: ta-t.has-hover ? Theme.surface2
                                : (idx == root.current-index ? Theme.surface1 : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text {
                                    text: idx < root.labels.length ? root.labels[idx] : "";
                                    color: Theme.accent;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            ta-t := TouchArea {
                                clicked => {
                                    root.selected(idx);
                                    root.open = false;
                                    popup.close();
                                }
                                mouse-cursor: pointer;
                            }
                        }

                        // --- GUI Apps section header ---
                        if root.gui-count > 0: Rectangle {
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "GUI Apps";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // GUI app items
                        for idx in root.gui-count: Rectangle {
                            height: 22px;
                            border-radius: 3px;
                            background: ta-g.has-hover ? Theme.surface2
                                : ((idx + root.terminal-count) == root.current-index ? Theme.surface1 : transparent);
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 8px;
                                spacing: 4px;
                                Text {
                                    text: (idx + root.terminal-count) < root.labels.length
                                        ? root.labels[idx + root.terminal-count]
                                        : "";
                                    color: Theme.fg;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            ta-g := TouchArea {
                                clicked => {
                                    root.selected(idx + root.terminal-count);
                                    root.open = false;
                                    popup.close();
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Panel (one tab's content)
// Order: Target Window → Injection Mode → Timing → Start/Stop
// ---------------------------------------------------------------------------
component PanelView inherits Rectangle {
    in property <PanelData> data;
    callback on_key(int, int);
    callback on_mode(int, int);
    callback on_interval_sec(int, string);
    callback on_interval_min(int, string);
    callback on_duration(int, string);
    callback on_target(int, int);
    callback on_filter(int, string);
    callback on_refresh(int);
    callback on_start(int);
    callback on_stop(int);

    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 6px;

            // ---- Key selection ----
            Card {
                header: "KEY";
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        model: data.keys;
                        current-index: data.key_index;
                        selected(value) => {
                            root.on_key(data.id, self.current-index);
                        }
                    }
                    Text {
                        text: data.key_desc;
                        color: Theme.muted2;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Target window (dropdown + refresh) ----
            Card {
                header: "TARGET WINDOW";
                HorizontalLayout {
                    spacing: 6px;
                    TargetDropdown {
                        labels: data.target_labels;
                        current-index: data.target_index;
                        terminal-count: data.terminal_count;
                        search-text: data.search_text;
                        selected(idx) => { root.on_target(data.id, idx); }
                        filter(txt) => { root.on_filter(data.id, txt); }
                    }
                    Btn {
                        label: data.scanning ? "..." : "Refresh";
                        disabled: data.scanning;
                        clicked => { root.on_refresh(data.id); }
                    }
                }
            }

            // ---- Injection mode ----
            Card {
                header: "INJECTION MODE";
                ComboBox {
                    model: ["Window (PostMessage / Console / SendInput)", "Screen (OS-level SendInput)"];
                    current-index: data.mode_index;
                    selected(value) => {
                        root.on_mode(data.id, self.current-index);
                    }
                }
            }

            // ---- Timing (compact single row) ----
            Card {
                header: "TIMING";
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Interval";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text: data.interval_sec;
                        width: 40px;
                        height: 22px;
                        font-size: 11px;
                        edited(t) => { root.on_interval_sec(data.id, t); }
                    }
                    Text {
                        text: "s";
                        color: Theme.muted2;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text: data.interval_min;
                        width: 40px;
                        height: 22px;
                        font-size: 11px;
                        edited(t) => { root.on_interval_min(data.id, t); }
                    }
                    Text {
                        text: "m";
                        color: Theme.muted2;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }
                    Text {
                        text: "Duration";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text: data.duration;
                        width: 40px;
                        height: 22px;
                        font-size: 11px;
                        edited(t) => { root.on_duration(data.id, t); }
                    }
                    Text {
                        text: "m (0 = forever)";
                        color: Theme.muted2;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Start / Stop + Status ----
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    label: data.running ? "Stop" : "Start";
                    clicked => {
                        if (data.running) {
                            root.on_stop(data.id);
                        } else {
                            root.on_start(data.id);
                        }
                    }
                }
                Text {
                    text: data.status;
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Tab strip entry: title + centered X close button.
// ---------------------------------------------------------------------------
component TabBtn inherits Rectangle {
    in property <string> title;
    in property <bool> active: false;
    callback clicked();
    callback close_requested();
    height: 28px;
    background: active ? Theme.accent : (title-ta.has-hover ? Theme.surface2 : Theme.surface1);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: active ? Theme.accent-hover : Theme.border;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 2px;
        Text {
            text: title;
            color: active ? Theme.fg : Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        title-ta := TouchArea { clicked => { root.clicked(); } }
        Rectangle {
            width: 20px;
            height: 20px;
            vertical-stretch: 0;
            CloseBtn {
                y: (parent.height - self.height) / 2;
                clicked => { root.close_requested(); }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Main application window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    preferred-width: 700px;
    preferred-height: 400px;
    min-width: 600px;
    min-height: 340px;
    background: Theme.bg;
    title: "AutoClick-RS";

    in-out property <[TabData]> tabs: [];
    in-out property <[PanelData]> panels: [];
    in-out property <int> current_idx: 0;
    in-out property <string> perm_warning: "";

    callback add_tab();
    callback close_all();
    callback select_tab(int);
    callback close_tab(int);
    callback refresh_targets(int);
    callback start_sender(int);
    callback stop_sender(int);
    callback key_changed(int, int);
    callback mode_changed(int, int);
    callback interval_sec_changed(int, string);
    callback interval_min_changed(int, string);
    callback duration_changed(int, string);
    callback target_changed(int, int);
    callback filter_targets(int, string);
    callback open_accessibility_settings();

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // ---- Top toolbar ----
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: "AutoClick-RS";
                color: Theme.fg;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { width: 6px; }
            Btn { label: "+ New";      clicked => { root.add_tab(); } }
            Btn { label: "Close All";  clicked => { root.close_all(); } }
        }

        // ---- Tab strip ----
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for tab[i] in tabs: TabBtn {
                title: tab.title;
                active: i == root.current_idx;
                clicked => { root.select_tab(i); }
                close_requested => { root.close_tab(i); }
            }
        }

        // ---- Divider ----
        Rectangle { height: 1px; background: Theme.border; }

        // ---- macOS Accessibility Warning ----
        if root.perm_warning != "":
            Rectangle {
                background: #2a0000;
                border-radius: Theme.rad;
                border-width: 1px;
                border-color: #550000;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: root.perm_warning;
                        color: #ff8888;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Btn {
                        label: "Open System Settings";
                        clicked => { root.open_accessibility_settings(); }
                    }
                }
            }

        // ---- Active panel ----
        if root.current_idx >= 0 && root.current_idx < root.panels.length:
            PanelView {
                data: root.panels[root.current_idx];
                on_key(id, k)          => { root.key_changed(id, k); }
                on_mode(id, m)         => { root.mode_changed(id, m); }
                on_interval_sec(id, v) => { root.interval_sec_changed(id, v); }
                on_interval_min(id, v) => { root.interval_min_changed(id, v); }
                on_duration(id, v)     => { root.duration_changed(id, v); }
                on_target(id, idx)     => { root.target_changed(id, idx); }
                on_filter(id, txt)     => { root.filter_targets(id, txt); }
                on_refresh(id)         => { root.refresh_targets(id); }
                on_start(id)           => { root.start_sender(id); }
                on_stop(id)            => { root.stop_sender(id); }
            }
    }
}
