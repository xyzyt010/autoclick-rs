import { Button, ComboBox, LineEdit, VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------------------
// Theme — strict black & white, no greys.
// ---------------------------------------------------------------------------
export global Theme {
    out property <color> bg:           #000000;
    out property <color> surface0:     #000000;
    out property <color> surface1:     #000000;
    out property <color> surface2:     #000000;
    out property <color> accent:       #000000;
    out property <color> accent-hover: #ffffff;
    out property <color> border:       #ffffff;
    out property <color> fg:           #ffffff;
    out property <color> fg-dim:       #777777;
    out property <color> danger:       #ff4444;
    out property <length> pad: 8px;
    out property <length> gap: 6px;
    out property <length> rad: 5px;
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------
export struct TabData {
    id: int,
    title: string,
}

export struct PanelData {
    id: int,
    key_index: int,
    mode_index: int,
    keys: [string],
    key_desc: string,
    interval_sec: string,
    interval_min: string,
    duration: string,
    target_index: int,
    target_labels: [string],
    // number of header rows + offset info needed to map selection
    // index 0 = TERMINALS header, terminal rows follow, then GUI header
    gui_header_index: int,   // position of "── GUI APPS ──" row (>=0 when both groups present)
    terminal_count: int,
    status: string,
    running: bool,
    scanning: bool,
}

// ---------------------------------------------------------------------------
// Reusable styled components
// ---------------------------------------------------------------------------

// Compact hover-aware button — black bg, white border, inverts on hover.
component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> disabled: false;
    callback clicked();
    height: 26px;
    min-width: 72px;
    background: disabled ? Theme.surface1 : (ta.has-hover ? #ffffff : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: #ffffff;
    opacity: disabled ? 0.4 : 1.0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: label;
            color: disabled ? Theme.fg-dim : (ta.has-hover ? #000000 : #ffffff);
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { if (!disabled) { root.clicked(); } }
        mouse-cursor: pointer;
    }
}

// X close button — centered vector cross (white), red hover tint.
component CloseBtn inherits Rectangle {
    callback clicked();
    width: 20px;
    height: 20px;
    border-radius: 3px;
    background: ta.has-hover ? #33ff4444 : transparent;
    Path {
        x: 5px;
        y: 5px;
        width: 10px;
        height: 10px;
        stroke: ta.has-hover ? #ff4444 : #ffffff;
        stroke-width: 2px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// Compact bordered section card — black bg + white outline.
component Card inherits Rectangle {
    in property <string> header;
    background: #000000;
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: #ffffff;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text {
            text: root.header;
            color: Theme.fg;
            font-size: 11px;
            font-weight: 600;
        }
        @children
    }
}

// Compact numeric text field — pure black bg, crisp white outline.
// Larger clickable area than a plain LineEdit for easy editing.
component TimeInput inherits Rectangle {
    in-out property <string> text;
    callback edited(string);
    width: 64px;
    height: 26px;
    background: #000000;
    border-width: 1px;
    border-color: #ffffff;
    border-radius: 4px;
    clip: true;
    field := TextInput {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.text;
        color: #ffffff;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        edited => {
            root.text = self.text;
            root.edited(self.text);
        }
    }
}

// Single dropdown row: header rows (is-header=true) are thin, centered,
// dim-white, and non-selectable. Target rows are white text on black,
// invert to black-on-white on hover / when selected.
component ComboRow inherits Rectangle {
    in property <string> text;
    in property <bool> is-header: false;
    in property <bool> selected: false;
    callback clicked();
    height: is-header ? 18px : 26px;
    background: is-header ? #000000
                : selected ? #ffffff
                : (ta.has-hover ? #ffffff : #000000);
    border-width: is-header ? 0px : 1px;
    border-color: is-header ? transparent : #ffffff;
    border-radius: is-header ? 0px : 3px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: is-header ? center : start;
        Text {
            text: root.text;
            color: is-header ? #dddddd
                   : (selected || ta.has-hover) ? #000000 : #ffffff;
            font-size: is-header ? 10px : 12px;
            font-weight: is-header ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => { if (!is-header) { root.clicked(); } }
        mouse-cursor: is-header ? default : pointer;
    }
}

// Target selector with section headers inside the opened list.
// model_count = total rows in labels (including headers),
// current_index = index into labels (headers included).
// selected callback receives the raw label index.
component TargetCombo inherits Rectangle {
    in property <[string]> labels;
    in property <int> current-index: -1;
    in property <int> gui-header-index: -1;
    callback selected(int);
    height: 28px;
    border-width: 1px;
    border-color: #ffffff;
    border-radius: Theme.rad;
    background: #000000;

    // closed face: shows current selection (skipping headers)
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: current-index >= 0 && current-index < labels.length ? labels[current-index] : "Select target...";
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }
        Path {
            width: 12px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            commands: "M 0 0 L 6 7 L 12 0";
            stroke: #ffffff;
            stroke-width: 2px;
            fill: transparent;
        }
    }
    open-ta := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { popup.show(); }
        mouse-cursor: pointer;
    }

    popup := PopupWindow {
        width: root.width;
        max-height: 300px;
        x: 0px;
        y: root.height;
        Rectangle {
            background: #000000;
            border-width: 1px;
            border-color: #ffffff;
            border-radius: Theme.rad;
            clip: true;
            ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-height: rows.height;
                rows := VerticalLayout {
                    spacing: 0px;
                    for row[i] in labels: ComboRow {
                        text: row;
                        is-header: i == 0 || i == gui-header-index;
                        selected: i == root.current-index;
                        clicked => {
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Panel (one tab's content)
// Order: Injection Mode -> Target -> Key -> Timing -> Start/Stop
// ---------------------------------------------------------------------------
component PanelView inherits Rectangle {
    in property <PanelData> data;
    callback on_key(int, int);
    callback on_mode(int, int);
    callback on_interval_sec(int, string);
    callback on_interval_min(int, string);
    callback on_duration(int, string);
    callback on_target(int, int);
    callback on_refresh(int);
    callback on_start(int);
    callback on_stop(int);

    ScrollView {
        VerticalLayout {
            padding: 4px;
            spacing: 6px;

            // ---- Injection mode ----
            Card {
                header: "INJECTION MODE";
                ComboBox {
                    model: ["Window (PostMessage / Console / SendInput)", "Screen (OS-level SendInput)"];
                    current-index: data.mode_index;
                    selected(value) => {
                        root.on_mode(data.id, self.current-index);
                    }
                }
            }

            // ---- Target window ----
            Card {
                header: "TARGET WINDOW";
                HorizontalLayout {
                    spacing: 6px;
                    TargetCombo {
                        labels: data.target_labels;
                        current-index: data.target_index;
                        gui-header-index: data.gui_header_index;
                        selected(idx) => { root.on_target(data.id, idx); }
                    }
                    Btn {
                        label: data.scanning ? "..." : "Refresh";
                        disabled: data.scanning;
                        clicked => { root.on_refresh(data.id); }
                    }
                }
            }

            // ---- Key selection ----
            Card {
                header: "KEY";
                HorizontalLayout {
                    spacing: 8px;
                    ComboBox {
                        model: data.keys;
                        current-index: data.key_index;
                        selected(value) => {
                            root.on_key(data.id, self.current-index);
                        }
                    }
                    Text {
                        text: data.key_desc;
                        color: Theme.fg-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Timing ----
            Card {
                header: "TIMING";
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "Interval";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_sec;
                        edited(t) => { root.on_interval_sec(data.id, t); }
                    }
                    Text {
                        text: "s";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.interval_min;
                        edited(t) => { root.on_interval_min(data.id, t); }
                    }
                    Text {
                        text: "m";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 8px; }
                    Text {
                        text: "Duration";
                        color: #ffffff;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    TimeInput {
                        text: data.duration;
                        edited(t) => { root.on_duration(data.id, t); }
                    }
                    Text {
                        text: "m (0 = forever)";
                        color: Theme.fg-dim;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }

            // ---- Start / Stop + Status ----
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn {
                    label: data.running ? "Stop" : "Start";
                    clicked => {
                        if (data.running) {
                            root.on_stop(data.id);
                        } else {
                            root.on_start(data.id);
                        }
                    }
                }
                Text {
                    text: data.status;
                    color: #ffffff;
                    font-size: 12px;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Tab strip entry: title + centered X close button.
// ---------------------------------------------------------------------------
component TabBtn inherits Rectangle {
    in property <string> title;
    in property <bool> active: false;
    callback clicked();
    callback close_requested();
    height: 28px;
    background: active ? #000000 : (title-ta.has-hover ? #000000 : #000000);
    border-radius: Theme.rad;
    border-width: 1px;
    border-color: #ffffff;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 2px;
        alignment: center;
        Text {
            text: title;
            color: #ffffff;
            font-size: 12px;
            vertical-alignment: center;
        }
        title-ta := TouchArea { clicked => { root.clicked(); } }
        CloseBtn {
            width: 20px;
            height: 20px;
            vertical-stretch: 0;
            y: (parent.height - self.height) / 2;
            clicked => { root.close_requested(); }
        }
    }
}

// ---------------------------------------------------------------------------
// Main application window
// ---------------------------------------------------------------------------
export component AppWindow inherits Window {
    preferred-width: 700px;
    preferred-height: 400px;
    min-width: 600px;
    min-height: 340px;
    background: Theme.bg;
    title: "AutoClick-RS";

    in-out property <[TabData]> tabs: [];
    in-out property <[PanelData]> panels: [];
    in-out property <int> current_idx: 0;

    callback add_tab();
    callback close_all();
    callback select_tab(int);
    callback close_tab(int);
    callback refresh_targets(int);
    callback start_sender(int);
    callback stop_sender(int);
    callback key_changed(int, int);
    callback mode_changed(int, int);
    callback interval_sec_changed(int, string);
    callback interval_min_changed(int, string);
    callback duration_changed(int, string);
    callback target_changed(int, int);

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        // ---- Top toolbar ----
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: "AutoClick-RS";
                color: #ffffff;
                font-size: 14px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle { width: 6px; }
            Btn { label: "+ New";      clicked => { root.add_tab(); } }
            Btn { label: "Close All";  clicked => { root.close_all(); } }
        }

        // ---- Tab strip ----
        HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for tab[i] in tabs: TabBtn {
                title: tab.title;
                active: i == root.current_idx;
                clicked => { root.select_tab(i); }
                close_requested => { root.close_tab(i); }
            }
        }

        // ---- Divider ----
        Rectangle { height: 1px; background: #ffffff; }

        // ---- Active panel ----
        if root.current_idx >= 0 && root.current_idx < root.panels.length:
            PanelView {
                data: root.panels[root.current_idx];
                on_key(id, k)          => { root.key_changed(id, k); }
                on_mode(id, m)         => { root.mode_changed(id, m); }
                on_interval_sec(id, v) => { root.interval_sec_changed(id, v); }
                on_interval_min(id, v) => { root.interval_min_changed(id, v); }
                on_duration(id, v)     => { root.duration_changed(id, v); }
                on_target(id, idx)     => { root.target_changed(id, idx); }
                on_refresh(id)         => { root.refresh_targets(id); }
                on_start(id)           => { root.start_sender(id); }
                on_stop(id)            => { root.stop_sender(id); }
            }
    }
}
